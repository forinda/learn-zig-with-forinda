+/// The simplest search: try the needle at every place. What the others must agree with.
+fn countNaive(haystack: []const u8, needle: []const u8) usize {
+    if (needle.len == 0 or needle.len > haystack.len) return 0;
+    var found: usize = 0;
+    var i: usize = 0;
+    while (i + needle.len <= haystack.len) {
+        if (std.mem.eql(u8, haystack[i..][0..needle.len], needle)) {
+            found += 1;
+            i += needle.len; // matches don't overlap
+        } else i += 1;
+    }
+    return found;
+}
+
+test "Horspool, std.mem.count and the naive search agree" {
+    const text = "Heap takes the lead. Heap leads. Buffer takes the lead. HeapHeap. Hea";
+    for ([_][]const u8{ "Heap", "the lead", "H", "Hea", "Errdefer", "lead. Heap", "aa" }) |needle| {
+        const horspool: Horspool = .init(needle);
+        try std.testing.expectEqual(countNaive(text, needle), horspool.count(text));
+        try std.testing.expectEqual(std.mem.count(u8, text, needle), horspool.count(text));
+    }
+}
