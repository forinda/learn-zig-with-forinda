+/// Boyer-Moore-Horspool search: compare the needle at a place; on a mismatch, look at the haystack's byte
+/// under the needle's last position and jump as far as that byte allows. A byte that isn't in the needle
+/// lets it jump the needle's whole length.
+const Horspool = struct {
+    needle: []const u8,
+    skip: [256]usize,
+
+    fn init(needle: []const u8) Horspool {
+        var h: Horspool = .{ .needle = needle, .skip = @splat(needle.len) };
+        if (needle.len > 0) {
+            for (needle[0 .. needle.len - 1], 0..) |byte, i| h.skip[byte] = needle.len - 1 - i;
+        }
+        return h;
+    }
+
+    /// Where the needle next appears at or after `start`, or `null`.
+    fn find(self: *const Horspool, haystack: []const u8, start: usize) ?usize {
+        const n = self.needle.len;
+        if (n == 0) return null;
+        var i = start;
+        while (i + n <= haystack.len) {
+            if (std.mem.eql(u8, haystack[i..][0..n], self.needle)) return i;
+            i += self.skip[haystack[i + n - 1]];
+        }
+        return null;
+    }
+
+    /// How many times the needle appears, without overlaps.
+    fn count(self: *const Horspool, haystack: []const u8) usize {
+        var found: usize = 0;
+        var i: usize = 0;
+        while (self.find(haystack, i)) |at| {
+            found += 1;
+            i = at + self.needle.len;
+        }
+        return found;
+    }
+};
+
+/// Writes `text` in lines of at most `width` columns, breaking between words (greedy: as many words as
+/// fit on each line). A word longer than the width gets a line of its own.
+fn wrap(w: *std.Io.Writer, text: []const u8, width: usize) !void {
+    var column: usize = 0;
+    var words = std.mem.tokenizeScalar(u8, text, ' ');
+    while (words.next()) |word| {
+        if (column > 0 and column + 1 + word.len > width) {
+            try w.writeByte('\n');
+            column = 0;
+        }
+        if (column > 0) {
+            try w.writeByte(' ');
+            column += 1;
+        }
+        try w.writeAll(word);
+        column += word.len;
+    }
+    if (column > 0) try w.writeByte('\n');
+}
