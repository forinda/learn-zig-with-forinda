+    while (lines.next()) |line| {
+        try std.testing.expect(line.len <= 20);
+        var it = std.mem.tokenizeScalar(u8, line, ' ');
+        while (it.next()) |_| words += 1;
+    }
+    try std.testing.expectEqual(@as(usize, 14), words);
+}
