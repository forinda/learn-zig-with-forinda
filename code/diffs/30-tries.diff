+/// A trie: a tree of prefixes, one node per letter, so every word starting with the same letters shares
+/// those nodes. The nodes live in one list and point at each other by index: a node's first child, and
+/// its next sibling (the next child of the same parent). Letters are stored in lower case.
+const Trie = struct {
+    nodes: std.ArrayList(Node),
+
+    const Node = struct {
+        letter: u8,
+        first_child: ?u32 = null,
+        next_sibling: ?u32 = null,
+        value: ?u8 = null, // set where a word ends: what the word stands for (a rider's letter)
+    };
+
+    fn init(gpa: std.mem.Allocator) !Trie {
+        var trie: Trie = .{ .nodes = .empty };
+        try trie.nodes.append(gpa, .{ .letter = 0 }); // the root: the empty prefix
+        return trie;
+    }
+
+    fn deinit(self: *Trie, gpa: std.mem.Allocator) void {
+        self.nodes.deinit(gpa);
+    }
+
+    /// The child of `node` for `letter`, if there is one.
+    fn child(self: *const Trie, node: u32, letter: u8) ?u32 {
+        var next = self.nodes.items[node].first_child;
+        while (next) |i| : (next = self.nodes.items[i].next_sibling) {
+            if (self.nodes.items[i].letter == letter) return i;
+        }
+        return null;
+    }
+
+    fn insert(self: *Trie, gpa: std.mem.Allocator, word: []const u8, value: u8) !void {
+        var node: u32 = 0;
+        for (word) |raw| {
+            const letter = std.ascii.toLower(raw);
+            node = self.child(node, letter) orelse blk: {
+                const new: u32 = @intCast(self.nodes.items.len);
+                // the new node goes first among its siblings (appending may move the list: index, not pointer)
+                try self.nodes.append(gpa, .{ .letter = letter, .next_sibling = self.nodes.items[node].first_child });
+                self.nodes.items[node].first_child = new;
+                break :blk new;
+            };
+        }
+        self.nodes.items[node].value = value;
+    }
+
+    /// The values of every word that starts with `prefix`, written into `found` (as many as fit).
+    fn complete(self: *const Trie, prefix: []const u8, found: []u8) []u8 {
+        var node: u32 = 0;
+        for (prefix) |raw| node = self.child(node, std.ascii.toLower(raw)) orelse return found[0..0];
+        var n: usize = 0;
+        self.collect(node, found, &n);
+        return found[0..n];
+    }
+
+    /// Every value at or below `node`: a depth-first walk, by recursion.
+    fn collect(self: *const Trie, node: u32, found: []u8, n: *usize) void {
+        if (self.nodes.items[node].value) |value| {
+            if (n.* < found.len) {
+                found[n.*] = value;
+                n.* += 1;
+            }
+        }
+        var next = self.nodes.items[node].first_child;
+        while (next) |i| : (next = self.nodes.items[i].next_sibling) self.collect(i, found, n);
+    }
+};
+
+/// A trie of the roster's names, each standing for its rider's letter.
+fn riderNames(gpa: std.mem.Allocator) !Trie {
+    var trie: Trie = try .init(gpa);
+    errdefer trie.deinit(gpa);
+    const field = try loadField(gpa, roster_text);
+    defer freeField(gpa, field); // the trie copies the letters it needs, not the names
+    for (field) |rider| try trie.insert(gpa, rider.full_name, rider.name);
+    return trie;
+}
+
+/// The rider whose name starts with `typed`, if exactly one does.
+fn pickRiderByName(names: *const Trie, typed: []const u8) ?u8 {
+    var found: [2]u8 = undefined; // room for two: enough to tell "one" from "more than one"
+    const matches = names.complete(typed, &found);
+    return if (matches.len == 1) matches[0] else null;
+}
 
