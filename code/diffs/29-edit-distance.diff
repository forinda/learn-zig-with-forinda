+
+/// How many single-letter edits (insert, delete, change) turn `a` into `b`, ignoring case: the
+/// Levenshtein distance. Dynamic programming: the distance between the first i letters of `a` and the
+/// first j of `b` comes from three smaller ones, so the table is filled a row at a time, and only the
+/// previous row is needed to fill the next.
+fn editDistance(gpa: std.mem.Allocator, a: []const u8, b: []const u8) !usize {
+    const rows = try gpa.alloc(usize, 2 * (b.len + 1));
+    defer gpa.free(rows);
+    var previous = rows[0 .. b.len + 1];
+    var current = rows[b.len + 1 ..];
+    for (previous, 0..) |*d, j| d.* = j; // "" to the first j letters of b: j inserts
+    for (a, 1..) |letter_a, i| {
+        current[0] = i; // the first i letters of a to "": i deletes
+        for (b, 1..) |letter_b, j| {
+            const change: usize = if (std.ascii.toLower(letter_a) == std.ascii.toLower(letter_b)) 0 else 1;
+            current[j] = @min(
+                previous[j] + 1, // delete a's letter
+                current[j - 1] + 1, // insert b's letter
+                previous[j - 1] + change, // keep it, or change it
+            );
+        }
+        std.mem.swap([]usize, &previous, &current);
+    }
+    return previous[b.len];
+}
+
+/// A course found by name: which one, and how many edits away the name was (0: exactly).
+const CoursePick = struct { index: usize, distance: usize };
+
+/// The course whose name is closest to `typed`, if one is within 3 edits.
+fn closestCourse(gpa: std.mem.Allocator, typed: []const u8) !?CoursePick {
+    if (typed.len == 0) return null;
+    var best: ?CoursePick = null;
+    for (courses, 0..) |course, i| {
+        const distance = try editDistance(gpa, typed, course.name);
+        if (distance <= 3 and (best == null or distance < best.?.distance)) best = .{ .index = i, .distance = distance };
+    }
+    return best;
+}
 
