+test "a rider's fastest kilometre, from a window over its seconds" {
+    var split: Split = undefined;
+    var samples: [256]Sample = undefined;
+    split.init(&samples);
+    // 10 m/s for 100 s, then 20 m/s for 100 s: the fastest km is at 20 m/s, 50 s.
+    var position_m: f64 = 0;
+    for (1..201) |second| {
+        position_m += if (second <= 100) 10 else 20;
+        split.add(@intCast(second), position_m);
+    }
+    try std.testing.expectEqual(@as(?u32, 50), split.best_s);
+}
