+/// How much a course climbs, as prefix sums: the metres climbed from the start to where each segment
+/// starts. The climbing between any two points is then a subtraction, however long the course.
+const ClimbProfile = struct {
+    course: Course,
+    climbed_m: []f64,
+
+    fn init(gpa: std.mem.Allocator, course: Course) !ClimbProfile {
+        const climbed_m = try gpa.alloc(f64, course.segments.len);
+        var total_m: f64 = 0;
+        for (course.segments, climbed_m, 0..) |segment, *sum_m, i| {
+            sum_m.* = total_m; // climbed before this segment starts
+            const end_m = if (i + 1 < course.segments.len) course.segments[i + 1].start_m else course.distance_m;
+            total_m += (end_m - segment.start_m) * @max(segment.gradient_pct, 0) / 100;
+        }
+        return .{ .course = course, .climbed_m = climbed_m };
+    }
+
+    fn deinit(self: ClimbProfile, gpa: std.mem.Allocator) void {
+        gpa.free(self.climbed_m);
+    }
+
+    /// Metres climbed from the start to `position_m`: the sum up to its segment, plus the part of it ridden.
+    fn to(self: ClimbProfile, position_m: f64) f64 {
+        const at_m = @min(position_m, self.course.distance_m);
+        const i = self.course.segmentAt(at_m) orelse return 0;
+        const segment = self.course.segments[i];
+        return self.climbed_m[i] + (at_m - segment.start_m) * @max(segment.gradient_pct, 0) / 100;
+    }
+
+    /// Metres climbed between two points.
+    fn between(self: ClimbProfile, from_m: f64, to_m: f64) f64 {
+        return self.to(to_m) - self.to(from_m);
+    }
+};
+
+/// Where a rider was at one second.
+const Sample = struct { clock_s: u32, position_m: f64 };
+
+/// A rider's fastest kilometre, found with a sliding window over its recent seconds: the newest second
+/// is the window's right end; the left end moves on while the window still covers a kilometre.
+const Split = struct {
+    window: std.Deque(Sample),
+    best_s: ?u32 = null,
+
+    fn init(self: *Split, buf: []Sample) void {
+        self.* = .{ .window = .initBuffer(buf) };
+    }
+
+    fn add(self: *Split, clock_s: u32, position_m: f64) void {
+        if (self.window.len == self.window.buffer.len) _ = self.window.popFront(); // no room: drop the oldest
+        self.window.pushBackAssumeCapacity(.{ .clock_s = clock_s, .position_m = position_m });
+        // Every oldest sample a full km behind the newest is a candidate; the last of them is the shortest.
+        while (self.window.front()) |oldest| {
+            if (position_m - oldest.position_m < 1000) break;
+            const took_s = clock_s - oldest.clock_s;
+            if (self.best_s == null or took_s < self.best_s.?) self.best_s = took_s;
+            _ = self.window.popFront();
+        }
+    }
+};
