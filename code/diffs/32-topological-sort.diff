+    const rules = try parseUnlocks(gpa, &test_courses, "Linker Loop after Route Planner\nRoute Planner after Linker Loop");
+    defer gpa.free(rules);
+    try std.testing.expect(try seasonOrder(gpa, test_courses.len, rules) == null);
