+
+/// Which courses unlock after which, one rule a line: "Linker Loop after Compile Pass".
+const unlocks_text =
+    \\Linker Loop after Compile Pass
+    \\Route Planner after Linker Loop
+    \\Route Planner after Compile Pass
+;
+
+/// One rule: `course` comes after `after` (both indexes into the list of courses).
+const Unlock = struct { course: usize, after: usize };
+
+const UnlockError = error{ UnknownCourse, MissingAfter, OutOfMemory };
+
+/// Reads the rules in `text`, naming courses from `names` (case doesn't matter). The caller frees the rules.
+fn parseUnlocks(gpa: std.mem.Allocator, names: []const []const u8, text: []const u8) UnlockError![]Unlock {
+    var rules: std.ArrayList(Unlock) = .empty;
+    errdefer rules.deinit(gpa);
+    var lines = std.mem.tokenizeScalar(u8, text, '\n');
+    while (lines.next()) |raw| {
+        const line = std.mem.trim(u8, raw, " \t\r");
+        if (line.len == 0) continue;
+        const split = std.mem.indexOf(u8, line, " after ") orelse return error.MissingAfter;
+        const course = courseIndex(names, line[0..split]) orelse return error.UnknownCourse;
+        const after = courseIndex(names, line[split + " after ".len ..]) orelse return error.UnknownCourse;
+        try rules.append(gpa, .{ .course = course, .after = after });
+    }
+    return rules.toOwnedSlice(gpa);
+}
+
+fn courseIndex(names: []const []const u8, name: []const u8) ?usize {
+    for (names, 0..) |known, i| {
+        if (std.ascii.eqlIgnoreCase(known, std.mem.trim(u8, name, " "))) return i;
+    }
+    return null;
+}
+
+fn lowerFirst(_: void, a: usize, b: usize) std.math.Order {
+    return std.math.order(a, b);
+}
+
+/// An order for `count` courses in which every course comes after the ones it needs: a topological sort
+/// (Kahn's algorithm). Count how many courses each is waiting for; race any that wait for none; each one
+/// raced lets the courses waiting for it wait for one fewer. Ready courses go in list order, so the season
+/// is always the same. `null` if the rules go round in a circle (some courses never stop waiting).
+fn seasonOrder(gpa: std.mem.Allocator, count: usize, rules: []const Unlock) !?[]usize {
+    const waiting = try gpa.alloc(usize, count);
+    defer gpa.free(waiting);
+    @memset(waiting, 0);
+    for (rules) |rule| waiting[rule.course] += 1;
+
+    var ready: std.PriorityQueue(usize, void, lowerFirst) = .empty;
+    defer ready.deinit(gpa);
+    for (waiting, 0..) |w, course| if (w == 0) try ready.push(gpa, course);
+
+    var order: std.ArrayList(usize) = .empty;
+    errdefer order.deinit(gpa);
+    while (ready.pop()) |course| {
+        try order.append(gpa, course);
+        for (rules) |rule| {
+            if (rule.after != course) continue;
+            waiting[rule.course] -= 1;
+            if (waiting[rule.course] == 0) try ready.push(gpa, rule.course);
+        }
+    }
+    if (order.items.len < count) { // some courses never became ready: a circle
+        order.deinit(gpa);
+        return null;
+    }
+    return try order.toOwnedSlice(gpa);
+}
 
