+const test_courses = [_][]const u8{ "Compile Pass", "Linker Loop", "Route Planner" };
+
+test "the season races every course after the ones it needs" {
+    const gpa = std.testing.allocator;
+    const rules = try parseUnlocks(gpa, &test_courses, unlocks_text);
+    defer gpa.free(rules);
+    const order = (try seasonOrder(gpa, test_courses.len, rules)).?;
+    defer gpa.free(order);
+    try std.testing.expectEqualSlices(usize, &.{ 0, 1, 2 }, order);
+    for (rules) |rule| { // for every rule, the course it needs comes first
+        const course_at = std.mem.indexOfScalar(usize, order, rule.course).?;
+        const after_at = std.mem.indexOfScalar(usize, order, rule.after).?;
+        try std.testing.expect(after_at < course_at);
+    }
+}
