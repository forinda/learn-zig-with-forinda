+/// The places on the course map. Island has no roads: there's no way there.
+const Place = enum(u8) { start, bridge, pass, valley, lake, finish, island };
+const place_count = std.enums.values(Place).len;
+
+/// A road on the map, as written down: between two places, its length, and its gradient ridden from
+/// `a` to `b` (the other way, it's the opposite).
+const MapRoad = struct { a: Place, b: Place, length_m: f64, gradient_pct: f64 };
+
+const map_roads = [_]MapRoad{
+    .{ .a = .start, .b = .bridge, .length_m = 3000, .gradient_pct = 0 },
+    .{ .a = .bridge, .b = .pass, .length_m = 2500, .gradient_pct = 6 },
+    .{ .a = .pass, .b = .finish, .length_m = 3000, .gradient_pct = -5 },
+    .{ .a = .bridge, .b = .valley, .length_m = 4000, .gradient_pct = 1 },
+    .{ .a = .valley, .b = .lake, .length_m = 3000, .gradient_pct = 0 },
+    .{ .a = .lake, .b = .finish, .length_m = 2500, .gradient_pct = 0 },
+    .{ .a = .start, .b = .lake, .length_m = 9000, .gradient_pct = 0 },
+};
+
+/// A road leaving a place: where it goes, how long, how steep.
+const Road = struct { to: Place, length_m: f64, gradient_pct: f64 };
+
+/// The map as a graph: for each place, the list of roads leaving it (adjacency lists).
+const CourseMap = struct {
+    roads: [place_count]std.ArrayList(Road),
+
+    fn init(gpa: std.mem.Allocator, map_roads_: []const MapRoad) !CourseMap {
+        var map: CourseMap = .{ .roads = @splat(.empty) };
+        errdefer map.deinit(gpa);
+        for (map_roads_) |r| { // each road, both ways
+            try map.roads[@backingInt(r.a)].append(gpa, .{ .to = r.b, .length_m = r.length_m, .gradient_pct = r.gradient_pct });
+            try map.roads[@backingInt(r.b)].append(gpa, .{ .to = r.a, .length_m = r.length_m, .gradient_pct = -r.gradient_pct });
+        }
+        return map;
+    }
+
+    fn deinit(self: *CourseMap, gpa: std.mem.Allocator) void {
+        for (&self.roads) |*list| list.deinit(gpa);
+    }
+
+    /// The road from `a` to `b` (the shortest, if there are several), if there is one.
+    fn road(self: *const CourseMap, a: Place, b: Place) ?Road {
+        var best: ?Road = null;
+        for (self.roads[@backingInt(a)].items) |r| {
+            if (r.to == b and (best == null or r.length_m < best.?.length_m)) best = r;
+        }
+        return best;
+    }
+};
+
+/// The route with the fewest roads: breadth-first search. A queue visits places in order of how many
+/// roads away they are, so the first time the search reaches `to`, it's by the fewest roads.
+fn fewestRoads(gpa: std.mem.Allocator, map: *const CourseMap, from: Place, to: Place) !?[]Place {
+    var previous: [place_count]?Place = @splat(null);
+    var seen: std.EnumSet(Place) = .empty;
+    var queue: std.Deque(Place) = .empty;
+    defer queue.deinit(gpa);
+    seen.insert(from);
+    try queue.pushBack(gpa, from);
+    while (queue.popFront()) |place| {
+        if (place == to) return try routeTo(gpa, &previous, from, to);
+        for (map.roads[@backingInt(place)].items) |r| {
+            if (seen.contains(r.to)) continue;
+            seen.insert(r.to);
+            previous[@backingInt(r.to)] = place;
+            try queue.pushBack(gpa, r.to);
+        }
+    }
+    return null; // the queue ran dry: `to` can't be reached
+}
+
+/// A place to visit, and how far it is from the start by the best route found so far.
+const Visit = struct {
+    place: Place,
+    distance_m: f64,
+
+    fn closer(_: void, a: Visit, b: Visit) std.math.Order {
+        return std.math.order(a.distance_m, b.distance_m);
+    }
+};
+
+/// The shortest route by distance: Dijkstra's algorithm. A priority queue always hands out the nearest
+/// place not yet settled; a place's distance is final the first time it comes out.
+fn shortestRoute(gpa: std.mem.Allocator, map: *const CourseMap, from: Place, to: Place) !?[]Place {
+    var distance_m: [place_count]f64 = @splat(std.math.inf(f64));
+    var previous: [place_count]?Place = @splat(null);
+    var queue: std.PriorityQueue(Visit, void, Visit.closer) = .empty;
+    defer queue.deinit(gpa);
+    distance_m[@backingInt(from)] = 0;
+    try queue.push(gpa, .{ .place = from, .distance_m = 0 });
+    while (queue.pop()) |visit| {
+        if (visit.distance_m > distance_m[@backingInt(visit.place)]) continue; // an old, longer way here
+        if (visit.place == to) break;
+        for (map.roads[@backingInt(visit.place)].items) |r| {
+            const via_m = visit.distance_m + r.length_m;
+            if (via_m < distance_m[@backingInt(r.to)]) {
+                distance_m[@backingInt(r.to)] = via_m;
+                previous[@backingInt(r.to)] = visit.place;
+                try queue.push(gpa, .{ .place = r.to, .distance_m = via_m });
+            }
+        }
+    }
+    if (std.math.isInf(distance_m[@backingInt(to)])) return null;
+    return try routeTo(gpa, &previous, from, to);
+}
+
+/// The route to `to`, read backwards from where each place was reached from, then turned round.
+fn routeTo(gpa: std.mem.Allocator, previous: []const ?Place, from: Place, to: Place) ![]Place {
+    var route: std.ArrayList(Place) = .empty;
+    errdefer route.deinit(gpa);
+    var at = to;
+    while (true) {
+        try route.append(gpa, at);
+        if (at == from) break;
+        at = previous[@backingInt(at)].?;
+    }
+    std.mem.reverse(Place, route.items);
+    return route.toOwnedSlice(gpa);
+}
+
+/// A route as a course, in the course text format: one line per road. The caller frees it.
+fn routeCourseText(gpa: std.mem.Allocator, map: *const CourseMap, route: []const Place) ![]u8 {
+    var text: std.Io.Writer.Allocating = .init(gpa);
+    errdefer text.deinit();
+    for (route[0 .. route.len - 1], route[1..]) |a, b| {
+        const r = map.road(a, b).?; // consecutive places on a route always have a road
+        switch (Terrain.of(r.gradient_pct)) {
+            .flat => try text.writer.print("flat {d:.0}\n", .{r.length_m}),
+            .climb => try text.writer.print("climb {d:.0} {d}\n", .{ r.length_m, r.gradient_pct }),
+            .descent => try text.writer.print("descent {d:.0} {d}\n", .{ r.length_m, r.gradient_pct }),
+        }
+    }
+    return text.toOwnedSlice();
+}
+
+fn printRoute(w: *std.Io.Writer, route: []const Place) !void {
+    for (route, 0..) |place, i| try w.print("{s}{s}", .{ if (i > 0) " > " else "", @tagName(place) });
+}
 
